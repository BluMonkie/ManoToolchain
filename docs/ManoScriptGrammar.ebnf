program = { decl | stmt } ;

decl = vardecl | fundecl;
vardecl = "var" , IDENTIFIER , ":" , IDENTIFIER , [ "=" , expr] , ";" ;
fundecl = "fun" , IDENTIFIER , "(" , [ IDENTIFIER , ":", IDENTIFIER ] , { "," , IDENTIFIER , ":", IDENTIFIER } , ")" , [ "->" , IDENTIFIER , ":" , IDENTIFIER ] , block ; 

stmt = asm | block | if_stmt | while_stmt | expr_stmt ;
asm = "asm" , "{" , { ASM_INST } , "}" ;
block = "{" , { stmt | vardecl } , "}" ;
if_stmt = "if" , expr , block , [ "else" , ( block | if_stmt ) ] ;
while_stmt = "while" , expr , block ;
expr_stmt = expr , ";" ;

expr = assignment ;
assignment = ( (IDENTIFIER | "@" , IDENTIFIER) , "=" , assignment ) | comparison ;
comparison = bitwise , [ ( "<" | "<=" | ">" | ">=" | "==" | "!=" ) , bitwise ] ;
bitwise = shift , { ( "|" | "&" | "^" ) , shift } ;
shift = term , { ( "<<" | ">>" ) , term } ;
term = factor , { ( "+" | "-" ) , factor } ;
factor = unary , { ( "*" | "/" | "%") , unary } ;
unary = ( "+" | "-" | "~" ) , unary | primary;
primary = "(" , expr , ")" | LITERAL | IDENTIFIER | "@" , IDENTIFIER | call | "@" , call ;
call = IDENTIFIER , "(" , [ expr , { "," , expr } ] , ")" ;